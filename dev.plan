## 4. 数据库设计 (SQLite)

### 4.1 表结构

```sql
-- 观影记录表
-- 每条记录对应一次 Trakt 观影历史事件，同时存储 Trakt 返回的核心元数据
CREATE TABLE IF NOT EXISTS plays (
    id          INTEGER PRIMARY KEY AUTOINCREMENT,
    trakt_id    INTEGER NOT NULL,          -- Trakt 唯一 ID（单集/电影）
    tmdb_id     INTEGER,                  -- TMDB ID（用于获取海报）
    imdb_id     TEXT,                     -- IMDb ID
    title       TEXT    NOT NULL,
    year        INTEGER,
    media_type  TEXT    NOT NULL,          -- 'movie' | 'episode'
    runtime     INTEGER,                  -- 分钟
    genres      TEXT,                     -- JSON 数组，如 '["action","sci-fi"]'
    overview    TEXT,                     -- 剧情简介
    rating      REAL,                     -- 评分（0-10）
    votes       INTEGER,                  -- 评分人数
    watched_at  TEXT    NOT NULL,          -- ISO 8601: '2026-06-15T12:00:00.000Z'
    created_at  TEXT    DEFAULT (datetime('now')),
    UNIQUE(trakt_id, watched_at)
);

-- 媒体元数据表
-- 每个媒体（电影/剧集）只存一条，包含 Trakt 返回的全部详情 + TMDB 补充的海报
CREATE TABLE IF NOT EXISTS media (
    trakt_id      INTEGER PRIMARY KEY,     -- 电影用 movie.trakt_id，剧集用 show.trakt_id
    tmdb_id       INTEGER,
    imdb_id       TEXT,
    title         TEXT    NOT NULL,
    year          INTEGER,
    media_type    TEXT    NOT NULL,          -- 'movie' | 'show'
    slug          TEXT,                      -- Trakt URL slug
    tagline       TEXT,                      -- 电影标语
    overview      TEXT,                      -- 剧情简介
    poster_url    TEXT,                      -- TMDB 海报 CDN URL
    backdrop_url  TEXT,                      -- TMDB 背景图 CDN URL
    genres        TEXT,                      -- JSON 数组，如 '["动作","科幻"]'
    runtime       INTEGER,                  -- 分钟
    rating        REAL,                     -- 评分（0-10）
    votes         INTEGER,                  -- 评分人数
    certification TEXT,                      -- 分级，如 'PG-13', 'TV-MA'
    country       TEXT,                      -- 制片国家，如 'us'
    language      TEXT,                      -- 语言，如 'en'
    network       TEXT,                      -- 播出网络（剧集），如 'Netflix'
    status        TEXT,                      -- 状态，如 'released', 'ended'
    trailer_url   TEXT,                      -- 预告片链接
    homepage      TEXT,                      -- 官网
    first_aired   TEXT,                      -- 首播/上映日期
    comment_count INTEGER,                   -- Trakt 评论数
    updated_at    TEXT    DEFAULT (datetime('now'))
);

-- 月度统计表（物化聚合，加速查询）
CREATE TABLE IF NOT EXISTS monthly_stats (
    year_month  TEXT PRIMARY KEY,          -- '2026-06'
    total_count INTEGER DEFAULT 0,
    total_minutes INTEGER DEFAULT 0,
    movie_count INTEGER DEFAULT 0,
    episode_count INTEGER DEFAULT 0,
    updated_at  TEXT DEFAULT (datetime('now'))
);

-- 常用索引
CREATE INDEX IF NOT EXISTS idx_plays_watched_at ON plays(watched_at);
CREATE INDEX IF NOT EXISTS idx_plays_media_type ON plays(media_type);
CREATE INDEX IF NOT EXISTS idx_plays_trakt_id ON plays(trakt_id);
CREATE INDEX IF NOT EXISTS idx_plays_tmdb_id ON plays(tmdb_id);
```

### 4.2 关键查询示例

```sql
-- 按 key 快速查询某天的观影
SELECT * FROM plays WHERE watched_at >= '2026-06-15' AND watched_at < '2026-06-16';

-- 本月统计
SELECT COUNT(*) AS cnt, SUM(runtime) AS total_min
FROM plays WHERE watched_at >= '2026-06-01' AND watched_at < '2026-07-01';

-- 年度 Top 媒体
SELECT title, COUNT(*) AS watch_count
FROM plays WHERE watched_at >= '2026-01-01'
GROUP BY trakt_id ORDER BY watch_count DESC LIMIT 10;
```

