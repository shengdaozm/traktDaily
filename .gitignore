.env
.env.local

# 数据库和报告存储在私有仓库，不提交到公开仓库
data/trakt.db
data/reports/
data/*.db-journal
data/*.db-wal
data/*.db-shm

# 前端 JSON 数据存储在私有仓库，公开仓库不提交
# deploy 时从私有仓库拉取数据注入构建产物
web/public/data/

# 前端构建依赖和产物
web/node_modules/
web/dist/